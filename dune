(data_only_dirs template.distillery)

; Install the distillery template into lib/eliom/templates/os/ so that
; eliom-distillery picks it up at the standard location. The glob names
; dotfiles explicitly: `*` alone skips .eliomignore, .eliomverbatim,
; .eliomreserve, .gitignore and the editor configuration files.

(install
 (package ocsigen-start)
 (section lib_root)
 (files
  (glob_files_rec
   (template.distillery/{*,.*} with_prefix eliom/templates/os))))
