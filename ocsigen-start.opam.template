depexts: [
  ["imagemagick" "ruby-sass"] {os-family = "debian"}
  ["md5sha1sum" "sassc"] {os = "macos" & os-distribution = "homebrew"}
]

# The default build without "@doc" {with-doc}: the server and client
# libraries define the same modules, so dune's @doc fails with
# "Multiple rules generated". The published docs are built by odoc_driver.
# Keep in sync with the build dune generates by default (the install step
# comes from `(using dune_site ...)` in dune-project).
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
